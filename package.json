    "check-config": "tsx tools/check-config.ts"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
