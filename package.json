{
  "name": "black-boom",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "check-config": "tsx tools/check-config.ts",
    "start": "tsx server/index.ts",
    "tunnel-url": "docker compose logs tunnel 2>&1 | grep -o \"https://[a-z0-9-]*\\.trycloudflare\\.com\" | tail -1"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fontsource/kanit": "5.2.8",
    "pg": "8.23.1",
    "phaser": "^4.2.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
